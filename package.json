{
    "name": "minecraft-silver-frontend",
    "type": "module",
    "version": "1.0.0",
    "prettier": "@37bytes/prettier-config",
    "scripts": {
        "setupGitHooks": "node ./.gitHooks/setupGitHooks.cjs",
        "prepare": "npm run setupGitHooks",
        "start": "vite --host --config vite/vite.config.ts --mode=development",
        "build": "vite build --config vite/vite.config.ts --mode=build",
        "analyze": "webpack --profile --json > stats.json && webpack-bundle-analyzer stats.json",
        "typescript:lint": "tsc --noEmit",
        "typescript:swagger": "swagger-typescript-api --path ./.api-docs --output ./src/app/types/api --name apiTypes.ts  --no-client",
        "eslint:lint": "eslint --max-warnings=0 src --fix",
        "stylelint:lint": "stylelint 'src/**/*.{scss,css}' --max-warnings=0 --fix",
        "lint": "npm-run-all2 --parallel eslint:lint stylelint:lint typescript:lint",
        "lint-staged": "lint-staged",
        "test": "vitest run --config vite/vite.config.ts --mode=vitest --passWithNoTests",
        "test:ui": "npx loki test",
        "test:ui:update": "npx loki update --reactUri=file:./storybook-static",
        "test:ui:approve": "npx loki approve",
        "test:ui:json": "node scripts/generate-visual-json-report.js",
        "test:ui:html": "reg-cli --from .loki/report.json --report .loki/report.html ",
        "test:ui:report": "npm run test:ui:json && npm run test:ui:html",
        "storybook": "storybook dev -p 3010",
        "storybook:build": "storybook build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@37bytes/prettier-config": "1.0.2",
        "@storybook/addon-essentials": "8.4.7",
        "@storybook/addon-interactions": "8.4.7",
        "@storybook/addon-links": "8.4.7",
        "@storybook/blocks": "8.4.7",
        "@storybook/test": "8.4.7",
        "@types/dompurify": "3.0.5",
        "@types/node": "20.11.17",
        "@types/react": "18.2.55",
        "@types/react-dom": "18.2.19",
        "@types/sinon": "17.0.3",
        "@types/whatwg-fetch": "0.0.33",
        "dotenv": "16.4.1",
        "lint-staged": "15.2.10",
        "loki": "0.35.1",
        "prettier": "3.2.5",
        "reg-cli": "0.18.7",
        "sass": "1.83.0",
        "sinon": "19.0.2",
        "storybook": "8.4.7",
        "swagger-typescript-api": "13.0.3",
        "ts-node": "10.9.2",
        "typescript": "5.3.3",
        "whatwg-fetch": "3.6.20"
    },
    "dependencies": {
        "@37bytes/eslint-config": "2.0.1",
        "@37bytes/storage-fallback": "1.0.1",
        "@37bytes/stylelint-config": "1.0.12",
        "@nabla/vite-plugin-eslint": "2.0.5",
        "@reduxjs/toolkit": "2.1.0",
        "@sentry/react": "7.100.1",
        "@sentry/tracing": "7.100.1",
        "@sentry/vite-plugin": "2.22.7",
        "@storybook/react": "8.4.7",
        "@storybook/react-vite": "8.4.7",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "16.0.0",
        "@types/lodash-es": "4.17.12",
        "@vitejs/plugin-basic-ssl": "1.2.0",
        "@vitejs/plugin-react": "4.3.4",
        "autoprefixer": "10.4.20",
        "axios": "1.6.7",
        "clsx": "2.1.0",
        "date-fns": "3.6.0",
        "date-fns-tz": "3.0.0",
        "dompurify": "3.1.0",
        "eslint": "8.57.0",
        "jsdom": "25.0.1",
        "lodash-es": "4.17.21",
        "mobx": "6.13.6",
        "mobx-react-lite": "4.1.0",
        "npm-run-all2": "6.2.3",
        "query-string": "8.2.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-markdown": "9.0.1",
        "react-quill": "2.0.0",
        "react-redux": "9.1.0",
        "react-router-dom": "6.22.0",
        "react-use": "17.5.0",
        "redux": "5.0.1",
        "redux-thunk": "3.1.0",
        "reselect": "5.1.0",
        "stylelint": "15.11.0",
        "vite": "6.3.4",
        "vite-bundle-analyzer": "0.15.2",
        "vite-plugin-svgr": "4.3.0",
        "vite-tsconfig-paths": "5.1.4",
        "vitest": "3.0.5"
    },
    "loki": {
        "configurations": {
            "chrome.desktop": {
                "target": "chrome.docker",
                "width": 1920,
                "height": 1080,
                "deviceScaleFactor": 1,
                "mobile": false
            },
            "chrome.laptop": {
                "target": "chrome.docker",
                "width": 1366,
                "height": 768,
                "deviceScaleFactor": 1,
                "mobile": false
            },
            "chrome.iphone7": {
                "target": "chrome.docker",
                "preset": "iPhone 7"
            }
        }
    },
    "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c"
}
